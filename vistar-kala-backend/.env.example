# Server
PORT=4000
NODE_ENV=development

# Database - defaults to local SQLite file, zero config needed.
# To use Postgres/Supabase instead, set DB_DIALECT=postgres and DATABASE_URL.
DB_DIALECT=sqlite
DB_STORAGE=./data/vistarkala.sqlite
DATABASE_URL=

# Auth
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# OTP (mocked - no real SMS provider in the prototype)
OTP_EXPIRY_MINUTES=5
MOCK_OTP=123456

# CORS
CORS_ORIGIN=*

# Google Cloud Translation API (v2 / Basic)
# Required for dynamic translation of product names, descriptions, and chat messages.
# Get your key at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable the "Cloud Translation API" in your project first.
# Leave empty to disable dynamic translation (app still works, shows original text).
GOOGLE_TRANSLATE_API_KEY=
